#!/usr/bin/env bash
set -Eeuo pipefail

mode=${1:---check}
[[ "$mode" == --check || "$mode" == --install ]] || { printf 'Usage: install [--check|--install]\n' >&2; exit 2; }

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
skill_dir="$(dirname "$script_dir")"
skills_root="$(dirname "$skill_dir")"
cockpit_skill=/mnt/server-ssd/BJsWorkspace/cockpit
cockpit_cli="$cockpit_skill/bin/cockpit"
soul="$skills_root/souls/prime/soul.md"
stamp="$(date +%Y%m%d-%H%M%S)"

report_link() {
  local target=$1
  local source=$2
  if [[ -L "$target" && "$(readlink -f "$target")" == "$(readlink -f "$source")" ]]; then
    printf 'ok      %s -> %s\n' "$target" "$source"
  elif [[ -e "$target" || -L "$target" ]]; then
    printf 'replace %s -> %s\n' "$target" "$source"
  else
    printf 'create  %s -> %s\n' "$target" "$source"
  fi
}

install_link() {
  local target=$1
  local source=$2
  mkdir -p "$(dirname "$target")"
  if [[ -L "$target" && "$(readlink -f "$target")" == "$(readlink -f "$source")" ]]; then
    return 0
  fi
  if [[ -e "$target" || -L "$target" ]]; then
    mv -- "$target" "$target.pre-handbook-$stamp"
  fi
  ln -s -- "$source" "$target"
}

shell_hook='[ -r /home/admin/.config/bjslab/terminal-context.sh ] && . /home/admin/.config/bjslab/terminal-context.sh'

report_hook() {
  local target=$1
  if [[ -f "$target" ]] && grep -Fqx "$shell_hook" "$target"; then
    printf 'ok      %s contains bjslab terminal hook\n' "$target"
  else
    printf 'append  %s with bjslab terminal hook\n' "$target"
  fi
}

install_hook() {
  local target=$1
  touch "$target"
  grep -Fqx "$shell_hook" "$target" && return 0
  printf '\n# bjslab handbook pointer\n%s\n' "$shell_hook" >> "$target"
}

links=(
  "/home/admin/.codex/skills/handbook|$skill_dir"
  "/home/admin/.agents/skills/handbook|$skill_dir"
  "/home/admin/.claude/skills/handbook|$skill_dir"
  "/home/admin/.hermes/skills/handbook|$skill_dir"
  "/home/admin/.hermes/skills/cockpit-linear-board|$skill_dir/hermes-adapters/cockpit-linear-board"
  "/home/admin/.hermes/skills/bjslab-ops|$skill_dir/hermes-adapters/bjslab-ops"
  "/home/admin/.codex/skills/cockpit|$cockpit_skill"
  "/home/admin/.agents/skills/cockpit|$cockpit_skill"
  "/home/admin/.claude/skills/cockpit|$cockpit_skill"
  "/home/admin/.hermes/skills/cockpit|$cockpit_skill"
  "/home/admin/.local/bin/cockpit|$cockpit_cli"
  "/home/admin/.local/bin/handbook|$script_dir/handbook"
  "/home/admin/.local/bin/bjslab-cockpit|$script_dir/bjslab-cockpit"
  "/home/admin/.local/bin/bjslab-bws|$script_dir/bjslab-bws"
  "/home/admin/.config/bjslab/terminal-context.sh|$script_dir/terminal-context.sh"
  "/home/admin/.codex/AGENTS.md|$soul"
  "/home/admin/.claude/CLAUDE.md|$soul"
  "/home/admin/.config/opencode/AGENTS.md|$soul"
)

for mapping in "${links[@]}"; do
  target=${mapping%%|*}
  source=${mapping#*|}
  report_link "$target" "$source"
  [[ "$mode" == --install ]] && install_link "$target" "$source"
done

retired_links=(
  "/home/admin/.codex/skills/bjslab-context|$skills_root/bjslab-context"
  "/home/admin/.agents/skills/bjslab-context|$skills_root/bjslab-context"
  "/home/admin/.claude/skills/bjslab-context|$skills_root/bjslab-context"
  "/home/admin/.hermes/skills/bjslab-context|$skills_root/bjslab-context"
  "/home/admin/.local/bin/bjslab-context|$skills_root/bjslab-context/scripts/bjslab-context"
)

for mapping in "${retired_links[@]}"; do
  target=${mapping%%|*}
  source=${mapping#*|}
  if [[ -L "$target" && "$(readlink "$target")" == "$source" ]]; then
    printf 'remove  %s (renamed to handbook)\n' "$target"
    [[ "$mode" == --install ]] && unlink "$target"
  fi
done

retired_worker=/home/admin/.local/bin/bjslab-codex-worker
if [[ -L "$retired_worker" && "$(readlink "$retired_worker")" == "$script_dir/bjslab-codex-worker" ]]; then
  printf 'remove  %s (retired compatibility wrapper)\n' "$retired_worker"
  [[ "$mode" == --install ]] && unlink "$retired_worker"
fi

for shell_file in /home/admin/.bashrc /home/admin/.zshrc; do
  report_hook "$shell_file"
  [[ "$mode" == --install ]] && install_hook "$shell_file"
done

if [[ "$mode" == --check ]]; then
  printf 'check only; run with --install to apply\n'
fi
