#!/usr/bin/env bash
set -Eeuo pipefail

codex_bin=/home/admin/.local/bin/codex
[[ -x "$codex_bin" ]] || codex_bin="$(command -v codex 2>/dev/null || true)"
[[ -n "$codex_bin" && -x "$codex_bin" ]] || { printf 'Codex CLI unavailable\n' >&2; exit 2; }

exec "$codex_bin" exec \
  -c model_provider=opencodex \
  -c 'model_providers.opencodex={name="OpenCodex",base_url="http://127.0.0.1:10100/v1",wire_api="responses",requires_openai_auth=true,supports_websockets=false}' \
  "$@"
